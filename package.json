{
  "name": "pi-session-manager",
  "version": "0.1.0",
  "description": "Desktop manager for local Pi coding-agent sessions.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "tauri dev",
    "demo": "tauri dev -- -- --demo",
    "build": "tauri build --bundles nsis && node scripts/collect-release.mjs",
    "build:macos": "tauri build --bundles dmg",
    "build:linux": "tauri build --bundles deb,appimage",
    "build:debug": "tauri build --debug --no-bundle",
    "tauri": "tauri",
    "dev:renderer": "vite",
    "build:renderer": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "cargo test --manifest-path src-tauri/Cargo.toml",
    "test:e2e": "playwright test",
    "format": "prettier --write src shared tests src-tauri/*.json src-tauri/capabilities/*.json vite.config.ts playwright.config.ts",
    "format:check": "prettier --check src shared tests src-tauri/*.json src-tauri/capabilities/*.json vite.config.ts playwright.config.ts"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@tauri-apps/plugin-opener": "^2.5.5",
    "lucide-react": "^1.47.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "prettier": "^3.9.8",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
